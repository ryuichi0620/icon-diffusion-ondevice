# ---------- macOS ----------
.DS_Store
._*

# ---------- Python ----------
__pycache__/
*.py[cod]
.venv/
.venv-coreai/
venv/
*.egg-info/
.ipynb_checkpoints/

# ---------- 学習データ・成果物 ----------
# 生成した画像・学習済み重み・変換済みモデルはリポジトリに入れない。
# 置き場所は決めておきたいので .gitkeep だけ追跡する。
training/data/**
!training/data/.gitkeep
# 出所の記録だけは追跡する。データ本体は入れないが「どこから来たか」は
# 後から説明できる必要がある（docs/dataset.md の権利まわり）。
!training/data/SOURCE.md
# 被写体リストも出所の一部。画像は追跡しないがリストは残す
!training/data/subjects-*.txt
training/outputs/**
!training/outputs/.gitkeep
*.safetensors
*.ckpt
*.bin
*.pt
*.pth
*.aimodel
*.mlpackage
*.mlmodelc

# トークナイザ資産は 05_export_coreai.py が取得する（サイズが大きい）
ios/IconDiffusionKit/Sources/IconDiffusionKit/Resources/vocab.json
ios/IconDiffusionKit/Sources/IconDiffusionKit/Resources/merges.txt

# ---------- Xcode / SwiftPM ----------
# xcodegen が project.yml から生成する。手で編集しないので追跡しない
ios/IconDiffusionApp/IconDiffusionApp.xcodeproj/
# Stage 5 の出力を sync-resources.sh がコピーしてくる。約 1GB
ios/IconDiffusionApp/Models/**
!ios/IconDiffusionApp/Models/.gitkeep
build/
build-sim/
DerivedData/
.build/
.swiftpm/
*.xcuserstate
xcuserdata/

# ---------- 秘密情報 ----------
.env
*.pem
*.p12

# ---------- Claude Code ----------
.claude/settings.local.json

# diffusers から取得した学習スクリプトのキャッシュ
training/.vendor/
# 条件付け用グリフ（外部アイコン集から取得。出所の記録だけ追跡する）
training/data/glyphs/**
!training/data/glyphs/SOURCE.md
